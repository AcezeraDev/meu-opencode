{
  "manifest_version": 3,
  "name": "OpenCode Browser Bridge",
  "version": "0.5.0",
  "description": "Deixa o agente do OpenCode dirigir este navegador (seu perfil real) pelo protocolo DevTools.",
  "permissions": ["debugger", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenCode Browser Bridge"
  },
  "icons": {}
}
